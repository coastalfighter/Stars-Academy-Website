# ─────────────────────────────────────────────────────────────
# STARS Academy website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for metadata, sitemap, JSON-LD, and the
# same-origin check on POST /api/inquiry).
NEXT_PUBLIC_SITE_URL=https://www.mystarsacademy.org

# Extra origins allowed to POST to /api/inquiry (comma-separated).
# Preview deployments are usually listed here.
ALLOWED_ORIGINS=http://localhost:3000

# ── Inquiry delivery ─────────────────────────────────────────
# Configure at least ONE channel. If neither is configured, production
# returns 503 with the phone number so no inquiry is ever silently lost.

# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="STARS Website <website@mystarsacademy.org>"
INQUIRY_TO_EMAIL=info@mystarsacademy.org

# Option B: signed webhook (CRM, Zapier, Power Automate, etc.)
INQUIRY_WEBHOOK_URL=
# Shared secret used to sign the webhook body (HMAC-SHA256, hex) in the
# X-Stars-Signature header.
INQUIRY_WEBHOOK_SECRET=

# ── Abuse protection ─────────────────────────────────────────
# Max inquiries per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
