# ─────────────────────────────────────────────────────────────
# STARS Academy website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for metadata, sitemap, JSON-LD, and the
# same-origin check on POST /api/inquiry).
NEXT_PUBLIC_SITE_URL=https://www.mystarsacademy.org

# Extra origins allowed to POST to /api/inquiry (comma-separated).
# Preview deployments are usually listed here.
ALLOWED_ORIGINS=http://localhost:3000

# ── Inquiry delivery ─────────────────────────────────────────
# Configure at least ONE channel. If neither is configured, production
# returns 503 with the phone number so no inquiry is ever silently lost.

# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="STARS Website <website@mystarsacademy.org>"
INQUIRY_TO_EMAIL=info@mystarsacademy.org

# Option B: signed webhook (CRM, Zapier, Power Automate, etc.)
INQUIRY_WEBHOOK_URL=
# Shared secret used to sign the webhook body (HMAC-SHA256, hex) in the
# X-Stars-Signature header.
INQUIRY_WEBHOOK_SECRET=

# ── Abuse protection ─────────────────────────────────────────
# Max inquiries per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Shared rate limiting across serverless instances (Upstash Redis, free tier
# is plenty). Without these, each instance keeps its own in-memory window.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN
# instead; either pair works. Visitor IPs are HMAC-hashed before being sent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring ───────────────────────────────────────────────
# Alerts for server errors, failed inquiry deliveries and pages that fail to
# render. Any incoming webhook that accepts {"text": "..."} works: Slack,
# Google Chat, Mattermost, a Teams/Power Automate workflow…
ALERT_WEBHOOK_URL=
# Optional: signs alert bodies (HMAC-SHA256, hex) in X-Stars-Signature.
ALERT_WEBHOOK_SECRET=
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=info

# ── Content management (Sanity) ──────────────────────────────
# Optional. Without SANITY_PROJECT_ID the site uses the content bundled in the
# repo. All of these are server-side only.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Viewer-role token: lets editors preview unpublished changes ("draft mode").
SANITY_READ_TOKEN=
# Shared secret for the publish webhook → POST /api/revalidate.
SANITY_WEBHOOK_SECRET=
