# ─────────────────────────────────────────────────────────────
# STARS Academy website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for metadata, sitemap, JSON-LD, and the
# same-origin check on POST /api/inquiry).
NEXT_PUBLIC_SITE_URL=https://www.mystarsacademy.org

# Extra origins allowed to POST to /api/inquiry (comma-separated). Rarely
# needed: same-host requests (including preview URLs) are always allowed.
ALLOWED_ORIGINS=

# ── Inquiry delivery ─────────────────────────────────────────
# Configure at least ONE channel. If neither is configured, production
# returns 503 with the phone number so no inquiry is ever silently lost.

# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
# The sender must be on a domain verified in Resend (DNS records; see
# docs/LAUNCH.md, "Email"). A sending subdomain keeps it separate from any
# future staff mailboxes.
INQUIRY_FROM_EMAIL="STARS Website <website@send.mystarsacademy.org>"
# An inbox staff actually read every working day (comma-separate several).
# Note: as of October 2026 mystarsacademy.org has no mail service (no MX
# records), so don't use an @mystarsacademy.org address until it does.
INQUIRY_TO_EMAIL=

# Option B: signed webhook (CRM, Zapier, Power Automate, etc.)
INQUIRY_WEBHOOK_URL=
# Shared secret used to sign the webhook body (HMAC-SHA256, hex) in the
# X-Stars-Signature header.
INQUIRY_WEBHOOK_SECRET=

# ── Abuse protection ─────────────────────────────────────────
# Max inquiries per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Shared rate limiting across serverless instances (Upstash Redis, free tier
# is plenty). Without these, each instance keeps its own in-memory window.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN
# instead; either pair works. Visitor IPs are HMAC-hashed before being sent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoring ───────────────────────────────────────────────
# Alerts for server errors, failed inquiry deliveries and pages that fail to
# render. Any incoming webhook that accepts {"text": "..."} works: Slack,
# Google Chat, Mattermost, a Teams/Power Automate workflow…
ALERT_WEBHOOK_URL=
# Optional: signs alert bodies (HMAC-SHA256, hex) in X-Stars-Signature.
ALERT_WEBHOOK_SECRET=
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=info

# ── Website insights (privacy-friendly analytics) ────────────
# Cookieless, first-party daily counts (see docs/ANALYTICS.md). Stored in the
# Upstash database above; without it, counts live in server memory only.
# Set to "false" to switch analytics off completely.
ANALYTICS_ENABLED=true
# Staff dashboard at /admin/insights. Both are required to enable sign-in.
# Password: at least 12 characters. Secret: at least 32 random characters
# (e.g. `openssl rand -base64 48`). Changing the password signs everyone out.
INSIGHTS_PASSWORD=
INSIGHTS_SESSION_SECRET=

# ── Secure forms & text alerts (docs/PHI-INTEGRATIONS.md) ────
# Hosts allowed to receive health information from visitors (enrollment
# form, referral upload), comma-separated; ".example.com" allows subdomains.
# Adobe Acrobat Sign is always allowed. Only add a host after STARS has a
# signed BAA with that service. CMS links to other hosts are hidden + alerted.
SECURE_FORM_HOSTS=
# off (default) | dry-run (preview to the staff alert chat) | live
TEXT_ALERTS_MODE=off
# Secret for the Sanity webhook that triggers text alerts (defaults to
# SANITY_WEBHOOK_SECRET when empty).
TEXT_ALERTS_WEBHOOK_SECRET=
# Where to send alerts: your SMS provider's (or Zapier/Make's) https webhook,
# and the secret used to sign requests to it (X-Stars-Signature, HMAC hex).
TEXT_ALERTS_PROVIDER_URL=
TEXT_ALERTS_PROVIDER_SECRET=

# ── Search engines ───────────────────────────────────────────
# Set to "false" while the site is hosted temporarily (e.g. on *.vercel.app
# before launch): every page says noindex and robots.txt blocks crawling.
# Remove it on launch day.
SITE_INDEXABLE=
# Optional ownership tags. Prefer verifying the whole domain with a DNS TXT
# record in Google Search Console instead (docs/LAUNCH.md).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Content management (Sanity) ──────────────────────────────
# Optional. Without SANITY_PROJECT_ID the site uses the content bundled in the
# repo. All of these are server-side only.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
# Viewer-role token: lets editors preview unpublished changes ("draft mode").
SANITY_READ_TOKEN=
# Shared secret for the publish webhook → POST /api/revalidate.
SANITY_WEBHOOK_SECRET=
